---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ResearchBadge from '../components/ResearchBadge.astro';
import PeerReviewBanner from '../components/PeerReviewBanner.astro';
import CssIllustration from '../components/CssIllustration.astro';
import CitationBox from '../components/CitationBox.astro';
import ShareControls from '../components/ShareControls.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCategoryMeta } from '../lib/categories';
import {
  estimateReadingTimeMinutes,
  formatBanglaDate,
  formatReadingTimeBn,
} from '../lib/formatters';
import { canonicalUrl, withBase } from '../lib/urls';
import { buildArticleJsonLd } from '../lib/seo';

interface Props {
  article: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  relatedArticles: CollectionEntry<'articles'>[];
  relatedExplainers: CollectionEntry<'explainers'>[];
}

const { article, headings, relatedArticles, relatedExplainers } = Astro.props;
const { data, body } = article;
const categoryMeta = getCategoryMeta(data.category);
const readingMinutes = estimateReadingTimeMinutes(body || data.description);
const canonicalHref = canonicalUrl(Astro.url.pathname, Astro.site);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const motif = data.illustration_motif || categoryMeta.illustration;

const articleJsonLd = buildArticleJsonLd({
  headline: data.title,
  description: data.description,
  urlPath: Astro.url.pathname,
  datePublished: data.date,
  dateModified: data.updatedDate,
  authors: data.authors,
  desk: data.desk,
  categoryBn: categoryMeta.nameBn,
  tags: data.tags,
  doi: data.doi,
  sourceUrl: data.source_url,
  journal: data.journal,
  peerReviewed: data.peer_reviewed,
  imageUrl: data.image,
  site: Astro.site,
});
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={data.image}
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updatedDate || data.date).toISOString()}
  jsonLd={articleJsonLd}
  indexForSearch={true}
>
  <article class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="পৃষ্ঠা অবস্থান" class="mb-6 text-xs text-slate-500 sm:text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={withBase('/')} class="hover:text-teal-800 hover:underline">মূল পাতা</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a
            href={withBase(`/category/${categoryMeta.slug}`)}
            class="font-medium text-teal-800 hover:underline"
            data-pagefind-filter="বিভাগ"
          >
            {categoryMeta.nameBn}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-slate-700" aria-current="page">গবেষণা প্রতিবেদন</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="max-w-4xl">
      <div class="mb-4">
        <ResearchBadge
          researchType={data.research_type}
          peerReviewed={data.peer_reviewed}
          isSample={data.is_sample || data.status === 'sample'}
        />
      </div>

      <h1
        data-pagefind-meta="title"
        class="text-2xl font-bold leading-snug text-[#0B1F3A] sm:text-4xl lg:text-[2.35rem]"
      >
        {data.title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-slate-700 sm:text-xl">
        {data.description}
      </p>

      <!-- Metadata Bar -->
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-slate-200 py-3.5 text-xs text-slate-600 sm:text-sm">
        <div>
          <span class="text-slate-500">প্রতিবেদক ডেস্ক:</span>{' '}
          <strong class="font-semibold text-slate-800">{data.desk}</strong>
        </div>
        <div>
          <span class="text-slate-500">প্রকাশের তারিখ:</span>{' '}
          <time datetime={data.date.toISOString()} class="font-medium text-slate-800">
            {formatBanglaDate(data.date)}
          </time>
        </div>
        {
          data.updatedDate && (
            <div>
              <span class="text-slate-500">হালনাগাদ:</span>{' '}
              <time datetime={data.updatedDate.toISOString()} class="font-medium text-slate-800">
                {formatBanglaDate(data.updatedDate)}
              </time>
            </div>
          )
        }
        <div>
          <span class="font-medium text-teal-800">{formatReadingTimeBn(readingMinutes)}</span>
        </div>
        <div>
          <span class="text-slate-500">জার্নাল:</span>{' '}
          <span class="font-semibold text-slate-800" data-pagefind-meta="journal">{data.journal}</span>
        </div>
      </div>
    </header>

    <!-- Two-Column Editorial Body + Sidebar -->
    <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <!-- Hero Illustration / Licensed Image -->
        <div class="mb-6">
          {
            data.image ? (
              <figure>
                <img
                  src={withBase(data.image)}
                  alt={data.image_alt || data.title}
                  class="aspect-[16/9] w-full rounded-lg border border-slate-200 object-cover"
                />
                <figcaption class="mt-2 text-xs text-slate-500">
                  {data.image_attribution} (লাইসেন্স: {data.license})
                </figcaption>
              </figure>
            ) : (
              <div>
                <CssIllustration motif={motif} title={data.title} />
                <p class="mt-2 text-xs text-slate-500">
                  চিত্রণ: জীববিজ্ঞান মৌলিক বৈজ্ঞানিক ডায়াগ্রাম ({categoryMeta.nameBn}) — কোনো প্রকাশকের কপিরাইটযুক্ত ছবি ব্যবহৃত হয়নি।
                </p>
              </div>
            )
          }
        </div>

        <!-- Peer Review & Study Model Verification Banner -->
        <PeerReviewBanner
          researchType={data.research_type}
          peerReviewed={data.peer_reviewed}
          publicationStatus={data.publication_status}
          studyModel={data.study_model}
          journal={data.journal}
          isSample={data.is_sample || data.status === 'sample'}
        />

        <!-- Key Findings Summary Box -->
        {
          data.key_findings && data.key_findings.length > 0 && (
            <section
              aria-labelledby="key-findings-heading"
              class="my-6 rounded-lg border border-slate-200 bg-slate-50 p-5"
            >
              <h2 id="key-findings-heading" class="text-base font-bold text-[#0B1F3A]">
                একনজরে প্রধান বৈজ্ঞানিক তথ্য
              </h2>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
                {data.key_findings.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Main Bangla Journalistic Prose -->
        <div class="editorial-prose mt-6">
          <slot />
        </div>

        <!-- Tags -->
        <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-5">
          <span class="text-xs font-semibold text-slate-500">বিষয়সূচক ট্যাগ:</span>
          {
            data.tags.map((tag) => (
              <a
                href={`${withBase('/search')}?q=${encodeURIComponent(tag)}`}
                class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-teal-700 hover:text-teal-900"
              >
                #{tag}
              </a>
            ))
          }
        </div>

        <!-- Source Citation & Provenance -->
        <CitationBox
          title={data.title}
          authors={data.authors}
          journal={data.journal}
          doi={data.doi}
          sourceUrl={data.source_url}
          license={data.license}
          peerReviewed={data.peer_reviewed}
        />

        <!-- Sharing Controls -->
        <ShareControls title={data.title} canonicalHref={canonicalHref} />
      </div>

      <!-- Sticky Editorial Sidebar -->
      <aside class="space-y-6 lg:col-span-4" aria-label="নিবন্ধ সূচিপত্র ও সহায়ক তথ্য">
        <div class="lg:sticky lg:top-32 space-y-6">
          {
            tocHeadings.length > 0 && (
              <nav
                aria-labelledby="toc-heading"
                class="rounded-lg border border-slate-200 bg-slate-50/70 p-5"
              >
                <h2 id="toc-heading" class="text-sm font-bold tracking-wide text-[#0B1F3A] uppercase">
                  এই প্রতিবেদনের সূচিপত্র
                </h2>
                <ol class="mt-3 space-y-2 text-sm">
                  {tocHeadings.map((heading) => (
                    <li class={heading.depth === 3 ? 'pl-3 text-xs' : ''}>
                      <a
                        href={`#${heading.slug}`}
                        class="text-slate-700 hover:text-teal-800 hover:underline"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <!-- Quick Provenance Card -->
          <div class="rounded-lg border border-slate-200 bg-white p-5 text-sm">
            <h2 class="font-bold text-[#0B1F3A]">বৈজ্ঞানিক স্বচ্ছতা সূচক</h2>
            <ul class="mt-3 space-y-2 text-xs text-slate-600">
              <li class="flex justify-between border-b border-slate-100 pb-1.5">
                <span>প্রকাশনার ধরন:</span>
                <strong class="text-slate-800">{data.peer_reviewed ? 'পিয়ার-রিভিউকৃত' : 'প্রিপ্রিন্ট'}</strong>
              </li>
              <li class="flex justify-between border-b border-slate-100 pb-1.5">
                <span>মূল ভাষা হতে রূপান্তর:</span>
                <strong class="text-slate-800">মৌলিক বাংলা ব্যাখ্যা</strong>
              </li>
              <li class="flex justify-between pb-1">
                <span>চিকিৎসা পরামর্শ:</span>
                <strong class="text-slate-800">প্রযোজ্য নয় (শিক্ষামূলক)</strong>
              </li>
            </ul>
            <a
              href={withBase('/editorial-policy')}
              class="mt-3 inline-block text-xs font-semibold text-teal-800 hover:underline"
            >
              আমাদের সম্পাদনা ও যাচাই নীতিমালা পড়ুন →
            </a>
          </div>

          {
            relatedExplainers.length > 0 && (
              <div class="rounded-lg border border-teal-200 bg-teal-50/40 p-5">
                <h2 class="text-sm font-bold text-[#0B1F3A]">
                  মৌলিক ধারণা বুঝুন (বিজ্ঞান সহায়িকা)
                </h2>
                <ul class="mt-3 space-y-3">
                  {relatedExplainers.map((exp) => (
                    <li>
                      <a
                        href={withBase(`/explainers/${exp.id}`)}
                        class="block text-sm font-semibold text-teal-900 hover:underline"
                      >
                        {exp.data.title}
                      </a>
                      <p class="mt-0.5 text-xs text-slate-600 line-clamp-2">
                        {exp.data.description}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <!-- Related Articles -->
    {
      relatedArticles.length > 0 && (
        <section
          aria-labelledby="related-research-heading"
          class="mt-16 border-t border-slate-200 pt-10 data-pagefind-ignore"
          data-pagefind-ignore
        >
          <div class="mb-6 flex items-center justify-between">
            <h2 id="related-research-heading" class="text-xl font-bold text-[#0B1F3A] sm:text-2xl">
              সম্পর্কিত গবেষণা প্রতিবেদন
            </h2>
            <a
              href={withBase(`/category/${categoryMeta.slug}`)}
              class="text-sm font-semibold text-teal-800 hover:underline"
            >
              সকল {categoryMeta.nameBn} প্রতিবেদন →
            </a>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {relatedArticles.map((rel) => (
              <ArticleCard article={rel} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
