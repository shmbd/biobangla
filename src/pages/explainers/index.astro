---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CssIllustration from '../../components/CssIllustration.astro';
import { getCategoryMeta } from '../../lib/categories';
import { formatBanglaDate } from '../../lib/formatters';
import { withBase } from '../../lib/urls';

const explainers = (await getCollection('explainers'))
  .filter((e) => e.data.status === 'published' || e.data.status === 'sample')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="বিজ্ঞান সহায়িকা (Educational Explainers)"
  description="জীববিজ্ঞান ও চিকিৎসা জীববিজ্ঞানের মৌলিক ধারণা, গবেষণা পদ্ধতি, পিয়ার-রিভিউ ও জিনতত্ত্বের সহজ বাংলা ব্যাখ্যা।"
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="border-b border-slate-200 pb-6">
      <span class="text-xs font-bold tracking-wider text-teal-800 uppercase">শিক্ষামূলক সহায়িকা</span>
      <h1 class="mt-1 text-3xl font-bold text-[#0B1F3A] sm:text-4xl">
        বিজ্ঞান সহায়িকা ও মৌলিক ধারণা
      </h1>
      <p class="mt-2 max-w-3xl text-base text-slate-600">
        জটিল গবেষণাপত্র সহজে বোঝার জন্য প্রয়োজনীয় আণবিক জীববিজ্ঞান, বৈজ্ঞানিক পদ্ধতি এবং পরিভাষার ধারাবাহিক বাংলা ব্যাখ্যা।
      </p>
    </header>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        explainers.map((exp) => {
          const cat = getCategoryMeta(exp.data.category);
          return (
            <article class="editorial-card flex flex-col justify-between rounded-lg border border-slate-200 bg-white p-6">
              <div>
                <CssIllustration
                  motif={exp.data.illustration_motif || cat.illustration}
                  title={exp.data.title}
                  compact={true}
                  class="mb-4"
                />
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <span class="rounded border border-teal-200 bg-teal-50 px-2 py-0.5 font-semibold text-teal-900">
                    পাঠস্তর: {exp.data.difficulty}
                  </span>
                  <span class="font-medium text-slate-600">{cat.nameBn}</span>
                  <span class="text-slate-400">•</span>
                  <time datetime={exp.data.date.toISOString()} class="text-slate-500">
                    {formatBanglaDate(exp.data.date)}
                  </time>
                </div>

                <h2 class="mt-3 text-xl font-bold text-[#0B1F3A]">
                  <a href={withBase(`/explainers/${exp.id}`)} class="hover:text-teal-800">
                    {exp.data.title}
                  </a>
                </h2>

                <p class="mt-2 text-sm leading-relaxed text-slate-600">{exp.data.description}</p>
              </div>

              <div class="mt-5 border-t border-slate-100 pt-3">
                <a
                  href={withBase(`/explainers/${exp.id}`)}
                  class="text-sm font-semibold text-teal-800 hover:underline"
                >
                  পূর্ণাঙ্গ সহায়িকা পড়ুন →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>
