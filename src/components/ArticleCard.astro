---
import type { CollectionEntry } from 'astro:content';
import { getCategoryMeta } from '../lib/categories';
import {
  estimateReadingTimeMinutes,
  formatBanglaDate,
  formatReadingTimeBn,
} from '../lib/formatters';
import { withBase } from '../lib/urls';
import ResearchBadge from './ResearchBadge.astro';
import CssIllustration from './CssIllustration.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  showIllustration?: boolean;
}

const { article, showIllustration = true } = Astro.props;
const { data, id, body } = article;
const categoryMeta = getCategoryMeta(data.category);
const readingMinutes = estimateReadingTimeMinutes(body || data.description);
const articleHref = withBase(`/articles/${id}`);
const motif = data.illustration_motif || categoryMeta.illustration;
---

<article
  class="editorial-card flex h-full flex-col justify-between rounded-lg border border-slate-200 bg-white p-5"
>
  <div>
    {
      showIllustration && (
        <a href={articleHref} class="mb-4 block overflow-hidden rounded-md" tabindex="-1" aria-hidden="true">
          {data.image ? (
            <img
              src={withBase(data.image)}
              alt={data.image_alt || data.title}
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full rounded-md border border-slate-200 object-cover"
            />
          ) : (
            <CssIllustration motif={motif} title={data.title} compact={true} />
          )}
        </a>
      )
    }

    <div class="mb-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
      <a
        href={withBase(`/category/${categoryMeta.slug}`)}
        class="font-semibold text-teal-800 hover:text-[#0B1F3A] hover:underline"
      >
        {categoryMeta.nameBn}
      </a>
      <time datetime={data.date.toISOString()} class="text-slate-500">
        {formatBanglaDate(data.date)}
      </time>
    </div>

    <h3 class="text-lg font-bold leading-snug text-[#0B1F3A] sm:text-[1.15rem]">
      <a href={articleHref} class="hover:text-teal-800 focus-visible:outline-teal-700">
        {data.title}
      </a>
    </h3>

    <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-slate-600">
      {data.description}
    </p>
  </div>

  <div class="mt-4 border-t border-slate-100 pt-3.5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <ResearchBadge
        researchType={data.research_type}
        peerReviewed={data.peer_reviewed}
        isSample={data.is_sample || data.status === 'sample'}
        compact={true}
      />
      <span class="text-xs text-slate-500">
        {formatReadingTimeBn(readingMinutes)}
      </span>
    </div>
    <p class="mt-2 truncate text-xs text-slate-500">
      সূত্র: <span class="font-medium text-slate-700">{data.journal}</span>
    </p>
  </div>
</article>
