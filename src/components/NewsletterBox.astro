---
import { withBase } from '../lib/urls';
---

<section
  aria-labelledby="digest-placeholder-heading"
  class="rounded-xl border border-slate-200 bg-slate-50 p-6 sm:p-8"
>
  <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <span class="inline-block rounded border border-teal-200 bg-teal-50 px-2.5 py-0.5 text-xs font-semibold text-teal-900">
        সাপ্তাহিক বিজ্ঞান ডাইজেস্ট ও ফিড
      </span>
      <h2 id="digest-placeholder-heading" class="mt-2.5 text-xl font-bold text-[#0B1F3A] sm:text-2xl">
        নতুন গবেষণার সারসংক্ষেপ নিয়মিত অনুসরণ করুন
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">
        জীববিজ্ঞান একটি স্ট্যাটিক ও বিজ্ঞাপনমুক্ত ওপেন-সায়েন্স প্ল্যাটফর্ম। ইমেইল নিউজলেটার সেবাটি পরবর্তী সংস্করণের জন্য
        পরিকল্পনাধীন (Placeholder); বর্তমানে আপনি কোনো ব্যক্তিগত তথ্য প্রদান ছাড়াই সরাসরি আমাদের <strong>RSS 2.0</strong> অথবা{' '}
        <strong>Atom</strong> ফিডের মাধ্যমে নতুন সকল গবেষণা প্রতিবেদন পেতে পারেন।
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
      <a
        href={withBase('/rss.xml')}
        class="inline-flex items-center justify-center rounded-md bg-[#0B1F3A] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-800"
      >
        RSS 2.0 ফিড সাবস্ক্রাইব করুন
      </a>
      <a
        href={withBase('/atom.xml')}
        class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:border-teal-700"
      >
        Atom ফিড
      </a>
    </div>
  </div>
</section>
