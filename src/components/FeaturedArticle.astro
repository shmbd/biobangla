---
import type { CollectionEntry } from 'astro:content';
import { getCategoryMeta } from '../lib/categories';
import {
  estimateReadingTimeMinutes,
  formatBanglaDate,
  formatReadingTimeBn,
} from '../lib/formatters';
import { withBase } from '../lib/urls';
import ResearchBadge from './ResearchBadge.astro';
import CssIllustration from './CssIllustration.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { data, id, body } = article;
const categoryMeta = getCategoryMeta(data.category);
const readingMinutes = estimateReadingTimeMinutes(body || data.description);
const articleHref = withBase(`/articles/${id}`);
const motif = data.illustration_motif || categoryMeta.illustration;
---

<section
  aria-labelledby="featured-research-heading"
  class="rounded-xl border border-slate-200 bg-slate-50/70 p-6 sm:p-8 lg:p-10"
>
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <span class="rounded bg-[#0B1F3A] px-2.5 py-1 font-semibold tracking-wide text-white">
          প্রধান গবেষণা প্রতিবেদন
        </span>
        <a
          href={withBase(`/category/${categoryMeta.slug}`)}
          class="font-semibold text-teal-800 hover:underline"
        >
          {categoryMeta.nameBn}
        </a>
        <span aria-hidden="true" class="text-slate-300">•</span>
        <time datetime={data.date.toISOString()} class="text-slate-600">
          {formatBanglaDate(data.date)}
        </time>
        <span aria-hidden="true" class="text-slate-300">•</span>
        <span class="text-slate-600">{formatReadingTimeBn(readingMinutes)}</span>
      </div>

      <h1
        id="featured-research-heading"
        class="mt-4 text-2xl font-bold leading-snug text-[#0B1F3A] sm:text-3xl lg:text-[2.1rem]"
      >
        <a href={articleHref} class="hover:text-teal-800">
          {data.title}
        </a>
      </h1>

      <p class="mt-4 text-base leading-relaxed text-slate-700 sm:text-lg">
        {data.description}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <ResearchBadge
          researchType={data.research_type}
          peerReviewed={data.peer_reviewed}
          isSample={data.is_sample || data.status === 'sample'}
        />
        <span class="text-xs text-slate-600">
          প্রকাশনা উৎস: <strong class="text-slate-800">{data.journal}</strong>
          {data.doi && <span class="ml-1 font-mono text-[0.75rem] text-slate-500">(DOI: {data.doi})</span>}
        </span>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={articleHref}
          class="inline-flex items-center gap-2 rounded-md bg-[#0B1F3A] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-teal-800"
        >
          পূর্ণাঙ্গ ব্যাখ্যা পড়ুন
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={data.source_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-800 hover:text-[#0B1F3A] hover:underline"
        >
          মূল গবেষণাপত্র দেখুন ↗
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <a href={articleHref} class="block overflow-hidden rounded-lg">
        {
          data.image ? (
            <img
              src={withBase(data.image)}
              alt={data.image_alt || data.title}
              class="aspect-[16/9] w-full rounded-lg border border-slate-200 object-cover"
            />
          ) : (
            <CssIllustration motif={motif} title={data.title} />
          )
        }
      </a>
      <p class="mt-2 text-right text-xs text-slate-500">
        {data.image_attribution || 'চিত্রণ: জীববিজ্ঞান মৌলিক বৈজ্ঞানিক রেখাচিত্র (CC BY-NC 4.0)'}
      </p>
    </div>
  </div>
</section>
