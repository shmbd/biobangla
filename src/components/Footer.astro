---
import Logo from './Logo.astro';
import { CATEGORY_LIST } from '../lib/categories';
import { withBase } from '../lib/urls';
import { toBanglaDigits } from '../lib/formatters';

const currentYearBn = toBanglaDigits(new Date().getUTCFullYear());
---

<footer class="mt-20 border-t border-slate-200 bg-[#0B1F3A] text-slate-200">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Brand & Editorial Mission -->
      <div class="lg:col-span-4">
        <Logo showTagline={true} inverse={true} />
        <p class="mt-4 text-sm leading-relaxed text-slate-300">
          <strong>জীববিজ্ঞান (biobangla)</strong> একটি অলাভজনক ও শিক্ষামূলক বাংলা বিজ্ঞান সাংবাদিকতা উদ্যোগ।
          বিশ্বজুড়ে প্রকাশিত জীববিজ্ঞান ও চিকিৎসা জীববিজ্ঞানের গবেষণাপত্রের মূল প্রশ্ন, পদ্ধতি, ফলাফল এবং সীমাবদ্ধতা
          আমরা তথ্যনিষ্ঠ ও সহজ বাংলায় উপস্থাপন করি।
        </p>
        <p class="mt-3 rounded border border-slate-700 bg-slate-900/60 p-3 text-xs leading-relaxed text-slate-300">
          <strong>চিকিৎসা সতর্কবার্তা:</strong> এই ওয়েবসাইটের কোনো প্রতিবেদন চিকিৎসকের পরামর্শ, রোগ নির্ণয় বা
          চিকিৎসার বিকল্প নয়। স্বাস্থ্যসংক্রান্ত যেকোনো সিদ্ধান্তের জন্য নিবন্ধিত চিকিৎসকের পরামর্শ নিন।
        </p>
      </div>

      <!-- Categories Column 1 -->
      <div class="lg:col-span-3">
        <h2 class="text-sm font-semibold tracking-wider text-teal-300 uppercase">
          গবেষণার বিভাগসমূহ (১)
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            CATEGORY_LIST.slice(0, 5).map((cat) => (
              <li>
                <a
                  href={withBase(`/category/${cat.slug}`)}
                  class="text-slate-300 transition-colors hover:text-white hover:underline"
                >
                  {cat.nameBn}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Categories Column 2 -->
      <div class="lg:col-span-3">
        <h2 class="text-sm font-semibold tracking-wider text-teal-300 uppercase">
          গবেষণার বিভাগসমূহ (২)
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            CATEGORY_LIST.slice(5).map((cat) => (
              <li>
                <a
                  href={withBase(`/category/${cat.slug}`)}
                  class="text-slate-300 transition-colors hover:text-white hover:underline"
                >
                  {cat.nameBn}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Editorial & Platform Links -->
      <div class="lg:col-span-2">
        <h2 class="text-sm font-semibold tracking-wider text-teal-300 uppercase">
          সম্পাদকীয় ও নীতিমালা
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href={withBase('/about')} class="text-slate-300 hover:text-white hover:underline">
              আমাদের সম্পর্কে
            </a>
          </li>
          <li>
            <a href={withBase('/editorial-policy')} class="text-slate-300 hover:text-white hover:underline">
              সম্পাদনা নীতিমালা
            </a>
          </li>
          <li>
            <a href={withBase('/sources-attribution')} class="text-slate-300 hover:text-white hover:underline">
              উৎস ও স্বীকৃতি
            </a>
          </li>
          <li>
            <a href={withBase('/explainers')} class="text-slate-300 hover:text-white hover:underline">
              বিজ্ঞান সহায়িকা
            </a>
          </li>
          <li>
            <a href={withBase('/news')} class="text-slate-300 hover:text-white hover:underline">
              সকল সংবাদ আর্কাইভ
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="text-slate-300 hover:text-white hover:underline">
              যোগাযোগ ও সংশোধনী
            </a>
          </li>
          <li>
            <a href={withBase('/rss.xml')} class="text-slate-300 hover:text-white hover:underline">
              RSS 2.0 ফিড
            </a>
          </li>
          <li>
            <a href={withBase('/atom.xml')} class="text-slate-300 hover:text-white hover:underline">
              Atom ফিড
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-slate-800 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center">
      <p>
        © {currentYearBn} জীববিজ্ঞান (biobangla)। অবাণিজ্যিক শিক্ষামূলক উদ্দেশ্যে প্রকাশিত (CC BY-NC 4.0, মূল গবেষণাপত্রের স্বতন্ত্র লাইসেন্স সংরক্ষিত)।
      </p>
      <p>
        প্রতিটি প্রতিবেদনে মূল জার্নাল ও DOI সূত্র সংযুক্ত। প্রিপ্রিন্ট সর্বদা অ-পর্যালোচিত হিসেবে চিহ্নিত।
      </p>
    </div>
  </div>
</footer>
