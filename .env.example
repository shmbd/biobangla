# ============================================================================
# জীববিজ্ঞান (biobangla) — Environment Configuration Template
# Copy to .env for local development. NEVER commit real API keys to Git.
# In production, configure these values in GitHub Repository Secrets/Variables.
# ============================================================================

# --- Frontend / GitHub Pages Configuration ---
# Full canonical site URL (no trailing slash)
SITE_URL=https://biobangla.org
# Base path for GitHub Pages project repositories (e.g., /biobangla) or / for custom domain
BASE_PATH=/

# --- Research Source API Configuration ---
# Polite pool contact email required by Crossref, PubMed (NCBI Entrez), and Unpaywall/Europe PMC
PIPELINE_CONTACT_EMAIL=editorial@example.org
# Optional NCBI API key for higher PubMed E-utilities rate limit (10 req/s vs 3 req/s)
NCBI_API_KEY=
# Optional PLOS API key (if required by endpoint)
PLOS_API_KEY=

# --- Provider-Independent AI Writing Configuration ---
# Supported values: mock | openai | gemini | anthropic | openai_compatible
AI_PROVIDER=mock
# API key for the selected provider (leave blank when AI_PROVIDER=mock)
AI_API_KEY=
# Model identifier (e.g., gpt-4o-mini, gemini-2.5-flash, claude-3-5-sonnet-latest)
AI_MODEL=
# Optional custom base URL for OpenAI-compatible endpoints
AI_BASE_URL=
# Generation temperature (low temperature recommended for factual scientific journalism)
AI_TEMPERATURE=0.2

# --- Pipeline Execution Controls ---
MAX_CANDIDATES_PER_RUN=25
MAX_ARTICLES_TO_PUBLISH=5
REQUEST_TIMEOUT_SECONDS=25
PIPELINE_DRY_RUN=false
